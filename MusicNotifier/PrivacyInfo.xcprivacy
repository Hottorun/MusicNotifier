<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- MusicNotifier has no backend and no analytics SDK: nothing about the
	     user leaves the device except the artist/album lookups sent to Apple
	     Music, Last.fm and Spotify, which are not linked to the user. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 1C8F.1: settings this app reads and writes for itself. -->
				<string>1C8F.1</string>
				<!-- CA92.1: the app-group suite shared with the widget
				     extension, which reads the release snapshot. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
